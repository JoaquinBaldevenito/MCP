FROM ./mi_modelo_ollama/unsloth.Q4_K_M.gguf

# PARÁMETROS
PARAMETER repeat_penalty 1.05
PARAMETER temperature 0.1
PARAMETER num_ctx 8192
PARAMETER top_k 40
PARAMETER top_p 0.9

PARAMETER stop "<|end|>"
PARAMETER stop "<|user|>"
PARAMETER stop "<|assistant|>"

# PLANTILLA (Llama 3 Standard)
TEMPLATE """{{ if .System }}<|system|>
{{ .System }}<|end|>
{{ end }}{{ if .Prompt }}<|user|>
{{ .Prompt }}<|end|>
{{ end }}<|assistant|>
{{ .Response }}<|end|>"""